# Env vars and Docker/Kubernetes secret file paths for the production environment.
# Values under server/config/production.toml are the non-secret defaults; these fill
# the rest. server/config/production.toml has no bundled OIDC issuer or audience —
# both must be set here for the target IdP.

POSTIT_ENV=production

POSTIT__DATABASE__URL_FILE=/run/secrets/postit_database_url
POSTIT__AUDIT__PSEUDONYM_KEY_FILE=/run/secrets/postit_pseudonym_key
POSTIT__MAIL__SMTP__PASSWORD_FILE=/run/secrets/postit_smtp_password

POSTIT__AUTH__OIDC__ISSUER=https://issuer.example
POSTIT__AUTH__OIDC__AUDIENCES=["postit"]
POSTIT__AUTH__BOOTSTRAP__ADMIN_EMAIL=admin@example.com

POSTIT__SERVER__PUBLIC_URL=https://api.example.com
POSTIT__APP__PUBLIC_URL=https://app.example.com
POSTIT__CORS__ALLOWED_ORIGINS=["https://app.example.com"]
