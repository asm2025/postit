# Env vars and Docker/Kubernetes secret file paths for the production environment.
# Values under server/config/production.toml are the non-secret defaults; these fill
# the rest. server/config/production.toml has no bundled OIDC issuer or audience —
# both must be set here for the target IdP.

POSTLY_ENV=production

POSTLY__DATABASE__URL_FILE=/run/secrets/postly_database_url
POSTLY__AUDIT__PSEUDONYM_KEY_FILE=/run/secrets/postly_pseudonym_key
POSTLY__MAIL__SMTP__PASSWORD_FILE=/run/secrets/postly_smtp_password

POSTLY__AUTH__OIDC__ISSUER=https://issuer.example
POSTLY__AUTH__OIDC__AUDIENCES=["postly"]
POSTLY__AUTH__BOOTSTRAP__ADMIN_EMAIL=admin@example.com

POSTLY__SERVER__PUBLIC_URL=https://api.example.com
POSTLY__APP__PUBLIC_URL=https://app.example.com
POSTLY__CORS__ALLOWED_ORIGINS=["https://app.example.com"]
