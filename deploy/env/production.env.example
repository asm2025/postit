# Env vars for the production environment, for a deployment that is not
# docker/docker-compose.production.yml. Config lives in server/config/production.toml
# (including database.url, which carries no credentials); these fill the rest.
# production.toml has no bundled OIDC issuer or audience — both must be set here for the
# target IdP.
#
# Secrets are the keys of !ref/vault/production/postit.env. Supply them as plain env vars,
# as POSTIT_SECRETS_FILE=<path to that file>, or one file per value with the `_FILE` form
# (Docker/Kubernetes secrets), for example:
#   POSTIT__DATABASE__USERNAME_FILE=/run/secrets/postit_database_username
#   POSTIT__DATABASE__PASSWORD_FILE=/run/secrets/postit_database_password
#   POSTIT__AUDIT__PSEUDONYM_KEY_FILE=/run/secrets/postit_pseudonym_key
#   POSTIT__MAIL__SMTP__USERNAME_FILE=/run/secrets/postit_smtp_username
#   POSTIT__MAIL__SMTP__PASSWORD_FILE=/run/secrets/postit_smtp_password

POSTIT_ENV=production

POSTIT__AUTH__OIDC__ISSUER=https://auth.postit.com
POSTIT__AUTH__OIDC__AUDIENCES=["postit"]
POSTIT__AUTH__BOOTSTRAP__ADMIN_EMAIL=admin@postit.com

POSTIT__SERVER__PUBLIC_URL=https://api.postit.com
POSTIT__APP__PUBLIC_URL=https://app.postit.com
POSTIT__CORS__ALLOWED_ORIGINS=["https://app.postit.com"]
