# Env vars for the qa environment, for a deployment that is not docker/docker-compose.qa.yml.
# Complete reference: docs/configuration.md ("Required outside development"). Deployment
# guide: docs/deployment.md.
#
# Config lives in server/config/qa.toml, which already sets the issuer, audience, public
# URLs, CORS origins, SMTP host and sender for the qa hostnames (*.qa.postit.com). Change
# any of those here only if your deployment uses other hostnames. The database URL there
# points at the compose service postit-postgres, so a host without compose sets its own.
#
# Run one process per role from the one image: POSTIT_ROLE=api and POSTIT_ROLE=worker.
#
# Secrets are the keys of !ref/vault/qa/postit.env. Supply them as plain env vars, as
# POSTIT_SECRETS_FILE=<path to that file>, or one file per value with the `_FILE` form
# (Docker/Kubernetes secrets), for example:
#   POSTIT__DATABASE__USERNAME_FILE=/run/secrets/postit_database_username
#   POSTIT__DATABASE__PASSWORD_FILE=/run/secrets/postit_database_password
#   POSTIT__AUDIT__PSEUDONYM_KEY_FILE=/run/secrets/postit_pseudonym_key
#   POSTIT__MAIL__SMTP__USERNAME_FILE=/run/secrets/postit_smtp_username
#   POSTIT__MAIL__SMTP__PASSWORD_FILE=/run/secrets/postit_smtp_password

POSTIT_ENV=qa
# api or worker (required outside development). Set per service.
POSTIT_ROLE=api

# Where Postgres is, without credentials.
POSTIT__DATABASE__URL=postgres://db.example.internal:5432/postit

# The container image already uses 8080 (API) and 8081 (worker); set these only for a
# binary run outside the image, where the default is 44310 and 44311.
# POSTIT__SERVER__API_PORT=8080
# POSTIT__SERVER__WORKER_PORT=8081

# Addresses or CIDRs of your reverse proxy. Forwarded headers are trusted only from these.
POSTIT__SERVER__TRUSTED_PROXIES=["10.0.0.0/24"]

# Already set by qa.toml for the qa hostnames:
# POSTIT__AUTH__OIDC__ISSUER=https://auth.qa.postit.com
# POSTIT__AUTH__OIDC__AUDIENCES=["postit-qa"]
# POSTIT__MAIL__SMTP__HOST=smtp.qa.postit.com
# POSTIT__MAIL__FROM_ADDRESS=postit <noreply@qa.postit.com>
# POSTIT__SERVER__PUBLIC_URL=https://api.qa.postit.com
# POSTIT__APP__PUBLIC_URL=https://app.qa.postit.com
# POSTIT__CORS__ALLOWED_ORIGINS=["https://app.qa.postit.com"]

POSTIT__AUTH__BOOTSTRAP__ADMIN_EMAIL=admin@postit.com
