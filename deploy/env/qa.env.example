# Env vars and Docker/Kubernetes secret file paths for the qa environment.
# Values under server/config/qa.toml are the non-secret defaults; these fill the rest.

POSTIT_ENV=qa

POSTIT__DATABASE__URL_FILE=/run/secrets/postit_database_url
POSTIT__AUDIT__PSEUDONYM_KEY_FILE=/run/secrets/postit_pseudonym_key
POSTIT__MAIL__SMTP__PASSWORD_FILE=/run/secrets/postit_smtp_password

POSTIT__AUTH__BOOTSTRAP__ADMIN_EMAIL=admin@qa.postit.example
