# Env vars for the qa environment, for a deployment that is not docker/docker-compose.qa.yml.
# Config lives in server/config/qa.toml (including database.url, which carries no
# credentials); these fill the rest.
#
# Secrets are the keys of !ref/vault/qa/postit.env. Supply them as plain env vars, as
# POSTIT_SECRETS_FILE=<path to that file>, or one file per value with the `_FILE` form
# (Docker/Kubernetes secrets), for example:
#   POSTIT__DATABASE__USERNAME_FILE=/run/secrets/postit_database_username
#   POSTIT__DATABASE__PASSWORD_FILE=/run/secrets/postit_database_password
#   POSTIT__AUDIT__PSEUDONYM_KEY_FILE=/run/secrets/postit_pseudonym_key
#   POSTIT__MAIL__SMTP__USERNAME_FILE=/run/secrets/postit_smtp_username
#   POSTIT__MAIL__SMTP__PASSWORD_FILE=/run/secrets/postit_smtp_password

POSTIT_ENV=qa

POSTIT__AUTH__BOOTSTRAP__ADMIN_EMAIL=admin@qa.postit.com
