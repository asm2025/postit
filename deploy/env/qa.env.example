# Env vars and Docker/Kubernetes secret file paths for the qa environment.
# Values under server/config/qa.toml are the non-secret defaults; these fill the rest.

POSTLY_ENV=qa

POSTLY__DATABASE__URL_FILE=/run/secrets/postly_database_url
POSTLY__AUDIT__PSEUDONYM_KEY_FILE=/run/secrets/postly_pseudonym_key
POSTLY__MAIL__SMTP__PASSWORD_FILE=/run/secrets/postly_smtp_password

POSTLY__AUTH__BOOTSTRAP__ADMIN_EMAIL=admin@qa.postly.example
