                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "oidc": []
          }
        ]
      },
      "delete": {
        "tags": [
          "me"
        ],
        "summary": "Starts deleting the caller's own account.",
        "description": "# Errors\n\nReturns 403 while pending (or for a disabled or already-deleting account, which `Auth`\nrejects first), 422 when the display name does not match, 409 for the last active admin.",
        "operationId": "delete_me",
        "requestBody": {
