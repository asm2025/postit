  "components": {
    "schemas": {
      "AuditEventDto": {
        "type": "object",
        "description": "One entry of the audit log.",
        "required": [
          "id",
          "at",
          "kind",
          "details"
        ],
        "properties": {
          "actor": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/UserRef",
                "description": "Who performed the action; none for system actions."
              },
              {
                "type": "null"
              }
            ]
          },
          "at": {
            "type": "string",
            "format": "date-time",
            "description": "When the event was recorded."
          },
          "details": {
            "type": "object",
            "description": "Event details. Every `*_user_id` value is a `UserRef` object."
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Event ID."
          },
          "ip": {
            "type": [
              "string",
              "null"
            ],
            "description": "Client IP, until it is cleared by retention."
          },
          "kind": {
            "$ref": "#/components/schemas/AuditEventKindDto",
            "description": "The event kind."
          },
          "owner": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/UserRef",
                "description": "Owner of the workspace the action touched."
              },
              {
                "type": "null"
              }
            ]
          },
          "request_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "`X-Request-Id` of the request that caused the event."
          },
          "subject": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/UserRef",
                "description": "Who the action was about."
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "AuditEventKindDto": {
        "type": "string",
        "description": "Every audit event kind (`AuditEventKind` in `postit-data`); the `OpenAPI` enum the web\nclient's kind filter is typed from. Clients must tolerate values added later.",
        "enum": [
          "user_provisioned",
          "user_approved",
          "user_disabled",
          "user_enabled",
          "role_changed",
          "bootstrap_admin_granted",
          "user_deleted",
          "email_sent",
          "email_dropped",
          "email_failed",
          "job_retried",
          "job_cancelled",
          "job_deleted",
          "job_triggered"
        ]
      },
      "AuthConfigDto": {
        "type": "object",
        "description": "What a client needs to start the OIDC sign-in.",
        "required": [
          "issuer",
          "client_id",
          "scopes"
        ],
        "properties": {
          "client_id": {
            "type": "string",
            "description": "OAuth client ID of the web and mobile clients."
          },
          "issuer": {
            "type": "string",
            "description": "Issuer URL of the identity provider."
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Scopes to request at sign-in."
          }
        }
      },
      "DeleteMeRequest": {
        "type": "object",
        "description": "Confirmation for deleting one's own account.",
        "required": [
          "display_name"
        ],
        "properties": {
          "display_name": {
            "type": "string",
            "description": "Must equal the caller's current display name."
          }
        }
      },
      "ErrorCode": {
        "type": "string",
        "description": "Machine-readable problem code (the `code` member of every problem+json body).",
        "enum": [
          "unauthenticated",
          "account_pending",
          "account_disabled",
          "forbidden",
          "not_found",
          "request_timeout",
          "user_deleting",
          "last_admin",
          "idempotency_in_progress",
          "version_conflict",
          "payload_too_large",
          "validation_failed",
          "idempotency_key_reused",
          "precondition_required",
          "rate_limited",
          "internal",
          "unavailable"
        ]
      },
      "MeDto": {
        "allOf": [
          {
            "$ref": "#/components/schemas/UserDto",
            "description": "The user's own record."
          },
          {
            "type": "object",
            "properties": {
              "account_url": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The identity provider's account page (`auth.oidc.account_url`), when configured."
              }
            }
          }
        ],
        "description": "The signed-in user."
      },
      "Page_AuditEventDto": {
        "type": "object",
        "description": "One page of results with its position in the full result set.",
        "required": [
          "data",
          "total",
          "page",
          "page_size"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "description": "One entry of the audit log.",
              "required": [
                "id",
                "at",
                "kind",
                "details"
              ],
              "properties": {
                "actor": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/UserRef",
                      "description": "Who performed the action; none for system actions."
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "at": {
                  "type": "string",
                  "format": "date-time",
                  "description": "When the event was recorded."
                },
                "details": {
                  "type": "object",
                  "description": "Event details. Every `*_user_id` value is a `UserRef` object."
                },
                "id": {
                  "type": "string",
                  "format": "uuid",
                  "description": "Event ID."
                },
                "ip": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Client IP, until it is cleared by retention."
                },
                "kind": {
                  "$ref": "#/components/schemas/AuditEventKindDto",
                  "description": "The event kind."
                },
                "owner": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/UserRef",
                      "description": "Owner of the workspace the action touched."
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "request_id": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "uuid",
                  "description": "`X-Request-Id` of the request that caused the event."
                },
                "subject": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/UserRef",
                      "description": "Who the action was about."
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            "description": "The items on this page."
          },
          "page": {
            "type": "integer",
            "format": "int64",
            "description": "1-based number of this page.",
            "minimum": 0
          },
          "page_size": {
            "type": "integer",
            "format": "int64",
            "description": "Items per page requested.",
            "minimum": 0
          },
          "total": {
            "type": "integer",
            "format": "int64",
            "description": "Total number of items across all pages.",
            "minimum": 0
          }
        }
      },
      "Page_UserDto": {
        "type": "object",
        "description": "One page of results with its position in the full result set.",
        "required": [
          "data",
          "total",
          "page",
          "page_size"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "description": "A postit user as admins and the user themselves see it. Profile fields come from the identity provider.",
              "required": [
                "id",
                "email_verified",
                "display_name",
                "role",
                "status",
                "created_at",
                "updated_at"
              ],
              "properties": {
                "approved_at": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date-time",
                  "description": "When an admin approved the user."
                },
                "approved_by": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "uuid",
                  "description": "The admin who approved the user."
                },
                "created_at": {
                  "type": "string",
                  "format": "date-time",
                  "description": "When the user was created."
                },
                "display_name": {
                  "type": "string",
                  "description": "Name shown in the UI."
                },
                "email": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Email address from the identity provider, when it supplied one."
                },
                "email_verified": {
                  "type": "boolean",
                  "description": "Whether the provider verified the email address."
                },
                "id": {
                  "type": "string",
                  "format": "uuid",
                  "description": "User ID."
                },
                "last_seen_at": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date-time",
                  "description": "When the user last made an authenticated request."
                },
                "role": {
                  "$ref": "#/components/schemas/RoleDto",
                  "description": "The user's role."
                },
                "status": {
                  "$ref": "#/components/schemas/StatusDto",
                  "description": "The user's account status."
                },
                "updated_at": {
                  "type": "string",
                  "format": "date-time",
                  "description": "When the user was last changed."
                }
              }
            },
            "description": "The items on this page."
          },
          "page": {
            "type": "integer",
            "format": "int64",
            "description": "1-based number of this page.",
            "minimum": 0
          },
          "page_size": {
            "type": "integer",
            "format": "int64",
            "description": "Items per page requested.",
            "minimum": 0
          },
          "total": {
            "type": "integer",
            "format": "int64",
            "description": "Total number of items across all pages.",
            "minimum": 0
          }
        }
      },
      "PatchUserRequest": {
        "type": "object",
        "description": "Exactly one of `status` or `role`.",
        "properties": {
          "role": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/RoleDto",
                "description": "The new role."
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/StatusDto",
                "description": "The new status."
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "ProblemDetails": {
        "type": "object",
        "description": "The RFC 9457 `application/problem+json` body every error response carries.",
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode",
            "description": "Machine-readable code."
          },
          "detail": {
            "type": [
              "string",
              "null"
            ],
            "description": "Explanation specific to this occurrence."
          },
          "request_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "The `X-Request-Id` of the failed request, for support."
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "description": "The HTTP status code.",
            "minimum": 0
          },
          "title": {
            "type": "string",
            "description": "Short summary of the problem type."
          },
          "type": {
            "type": "string",
            "description": "Always `about:blank`; `code` is the discriminator."
          }
        }
      },
      "RoleDto": {
        "type": "string",
        "description": "A user's role.",
        "enum": [
          "admin",
          "member"
        ]
      },
      "StatusDto": {
        "type": "string",
        "description": "A user's account status.",
        "enum": [
          "pending",
          "active",
          "disabled",
          "deleting"
        ]
      },
      "UserDto": {
        "type": "object",
        "description": "A postit user as admins and the user themselves see it. Profile fields come from the identity provider.",
        "required": [
          "id",
          "email_verified",
          "display_name",
          "role",
          "status",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "approved_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When an admin approved the user."
          },
          "approved_by": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "The admin who approved the user."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the user was created."
          },
          "display_name": {
            "type": "string",
            "description": "Name shown in the UI."
          },
          "email": {
            "type": [
              "string",
              "null"
            ],
            "description": "Email address from the identity provider, when it supplied one."
          },
          "email_verified": {
            "type": "boolean",
            "description": "Whether the provider verified the email address."
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "User ID."
          },
          "last_seen_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When the user last made an authenticated request."
          },
          "role": {
            "$ref": "#/components/schemas/RoleDto",
            "description": "The user's role."
          },
          "status": {
            "$ref": "#/components/schemas/StatusDto",
            "description": "The user's account status."
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the user was last changed."
          }
        }
      },
      "UserRef": {
        "type": "object",
        "description": "A user reference in the audit log. `deleted` is true for a pseudonym left by user\ndeletion (a UUID v8, which postit never generates otherwise). `display_name` is the\nuser's current name, or null for a pseudonym or a user no longer present.",
        "required": [
          "id",
          "deleted"
        ],
        "properties": {
          "deleted": {
            "type": "boolean",
            "description": "Whether the user has been deleted."
          },
          "display_name": {
            "type": [
              "string",
              "null"
            ],
            "description": "The user's current name, when known."
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "User ID, or the pseudonym that replaced it."
          }
        }
      }
    },
    "securitySchemes": {
      "oidc": {
        "type": "oauth2",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://idp.invalid/authorize",
            "tokenUrl": "https://idp.invalid/token",
            "scopes": {
              "email": "Email address",
              "offline_access": "Refresh tokens",
              "openid": "OpenID Connect sign-in",
              "profile": "Name and username"
            }
          }
        }
      }
    }
  }
