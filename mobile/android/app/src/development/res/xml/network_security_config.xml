<?xml version="1.0" encoding="utf-8"?>
<!-- Development flavor only, and only in debuggable builds: trust the postit dev CA. -->
<network-security-config>
    <debug-overrides>
        <trust-anchors>
            <certificates src="@raw/postit_dev_ca" />
            <certificates src="system" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
