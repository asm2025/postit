# Build context is the repository root (docker/server.Dockerfile). Keep it to what the
# image needs: server/ and web/.

# Build output, wherever cargo put it.
**/target

# Secrets and key material — never in an image layer. The vault directory is written
# `?ref`, not `!ref`: a leading `!` is .dockerignore's re-include operator, so the literal
# name would have un-ignored it instead.
?ref
docker/shared/nginx/certs
docker/zitadel/machinekey
**/local.toml
**/.env

.git
.github
app
*.md

# The web stage installs its own dependencies; never copy a host node_modules or build.
web/node_modules
web/dist
web/coverage
web/test-results
web/playwright-report
