# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Local config overrides and secrets
local.toml
.env
.env.*
!.env.example

# TLS certificates and Zitadel machine keys
*.pem
*.crt
*.key
*.p12
*.pfx
**/certs/
**/zitadel/machinekey/

# Web build output
web/node_modules/
web/dist/

# Flutter (mobile app) build output
app/build/
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies

# Extracted vault (the encrypted !ref/vault.7z is committed instead)
/!ref/vault

# Database dumps from `stack backup` (unencrypted user data; delete when done)
/!ref/backups

/!tmp/**
!/!tmp/.gitkeep
web/coverage/
web/test-results/
web/playwright-report/

app/android/key.properties
app/android/.gradle/
app/android/local.properties
app/ios/Pods/
app/ios/Flutter/Generated.xcconfig
app/coverage/
app/assets/dev/*.crt

# Local media storage (development)
.data/
