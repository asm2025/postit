  "db_name": "PostgreSQL",
  "query": "SELECT s.id, s.reason, s.at, c.id AS \"contact_id?\", c.email::text AS \"email?\"\n               FROM suppressions s\n               LEFT JOIN contacts c ON c.owner_id = s.owner_id AND c.email_hash = s.email_hash\n               WHERE s.owner_id = $1\n               ORDER BY s.at DESC, s.id DESC\n               LIMIT $2 OFFSET $3",
