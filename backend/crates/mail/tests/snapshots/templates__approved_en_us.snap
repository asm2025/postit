---
source: crates/mail/tests/templates.rs
expression: "rendered(&approved_content(), Locale::EnUs).html"
---
<!doctype html>
<html lang="en-US" dir="ltr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<title>Your postit account was approved</title>
<style>
body, table, td, a { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
table, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
body {
  margin: 0;
  padding: 0;
  width: 100% !important;
  min-width: 100%;
  background-color: #f8fafc;
  font-family: 'Onest', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Noto Sans Arabic', Helvetica, Arial, sans-serif;
  color: #1f1e24;
}
.wrapper {
  width: 100%;
  table-layout: fixed;
  background-color: #f8fafc;
  padding-block: 40px;
}
.main-card {
  background-color: #ffffff;
  margin-inline: auto;
  width: 100%;
  max-width: 560px;
  border-radius: 12px;
  border: 1px solid #e2e8f0;
  overflow: hidden;
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.04);
}
.header {
  padding-block: 32px 24px;
  padding-inline: 40px;
  text-align: start;
}
.content-body {
  padding-block: 0 32px;
  padding-inline: 40px;
  font-size: 15px;
  line-height: 1.6;
  color: #334155;
  text-align: start;
}
.btn {
  display: inline-block;
  padding-block: 12px;
  padding-inline: 28px;
  font-size: 15px;
  font-weight: 600;
  color: #1d1a1c !important;
  background-color: #e0679f;
  border-radius: 6px;
  text-decoration: none;
  text-align: center;
  margin-block: 20px;
}
.code-box {
  display: inline-block;
  padding-block: 14px;
  padding-inline: 28px;
  font-size: 26px;
  letter-spacing: 6px;
  font-weight: 700;
  font-family: 'Courier New', Courier, monospace;
  color: #1f1e24;
  background-color: #fbedf4;
  border: 1px solid #f6d1e2;
  border-radius: 8px;
  margin-block: 8px 20px;
}
.link-fallback {
  margin-block: 4px 0;
  font-size: 13px;
  word-break: break-all;
}
.link-fallback a { color: #a8336b; text-decoration: underline; }
.footer {
  padding-block: 24px 32px;
  padding-inline: 40px;
  border-top: 1px solid #f1f5f9;
  font-size: 12px;
  line-height: 1.5;
  color: #94a3b8;
  text-align: start;
}
@media only screen and (max-width: 600px) {
  .main-card { border-radius: 0; border: none; }
  .header, .content-body, .footer { padding-inline: 20px !important; }
}
</style>
</head>
<body>
<div class="wrapper">
<table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%">
<tr>
<td align="center">
<table role="presentation" border="0" cellpadding="0" cellspacing="0" class="main-card">
<tr>
<td class="header"><span style="font-size:24px;font-weight:800;color:#1d1a1c;letter-spacing:-0.5px"><bdi dir="ltr">post<span style="color:#e0679f">it</span></bdi></span></td>
</tr>
<tr>
<td class="content-body">
<p>Hi <bdi>Ada</bdi>,</p>
<p>An administrator approved your postit account. <a href="https://app.postit.test/">Sign in now</a></p>
</td>
</tr>
</table>
</td>
</tr>
</table>
</div>
</body>
</html>
