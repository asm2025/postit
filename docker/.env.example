# Copy to docker/.env (git-ignored) for local overrides. Compose reads it from the project
# directory, docker/, whichever environment file is layered on top. Development needs
# none of this.
#
# Secrets never go here — they live in !ref/vault/<environment>/<project>.env, which the
# compose files read with `env_file:`. This file is config only.

# Always include the development `app` profile (same as `stack up -App` / `--app`).
# COMPOSE_PROFILES=app

# development: allow self-registration on the Zitadel login page (default true). Read by
# `cargo xtask zitadel-bootstrap`; re-run it after a change.
# ZITADEL_ALLOW_REGISTRATION=false

# qa / production: run a promoted image instead of building postit-server:local.
# POSTIT_IMAGE=ghcr.io/<owner>/postit-server:<version>

# qa: the first-boot admin (default admin@postit.com).
# POSTIT_BOOTSTRAP_ADMIN_EMAIL=

# production: REQUIRED. docker-compose.production.yml refuses to resolve without these.
# POSTIT_API_URL=https://api.postit.com
# POSTIT_APP_URL=https://app.postit.com
# POSTIT_OIDC_ISSUER=https://auth.postit.com
# POSTIT_OIDC_AUDIENCE=postit
# POSTIT_SMTP_HOST=smtp.postit.com
# POSTIT_MAIL_FROM='postit <noreply@postit.com>'

# production: optional. The first-boot admin; may be left unset once an admin exists.
# POSTIT_BOOTSTRAP_ADMIN_EMAIL=admin@postit.com

# qa / production: the one proxy hop allowed to set X-Forwarded-For. Defaults to
# postit-net's gateway (172.30.0.1/32), which is how a reverse proxy on this host arrives.
# POSTIT_TRUSTED_PROXIES=172.30.0.1/32
